#include <windows.h>
1 ICON "resources/windows/BeeK.ico"
1 VERSIONINFO
FILEVERSION @VERSION_NUMBERS@
PRODUCTVERSION @VERSION_NUMBERS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "BeeK"
   VALUE "FileDescription", "BeeK AI selection translator"
   VALUE "FileVersion", "@VERSION@"
   VALUE "ProductName", "BeeK"
   VALUE "ProductVersion", "@VERSION@"
   VALUE "BeeKBuildId", "@BUILD_ID@"
   VALUE "LegalCopyright", "BeeK contributors"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
